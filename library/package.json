{
  "name": "solidstar",
  "author": "Katja Lutz <opensource@katjalutz.ch>",
  "description": "Datastar with SolidJS reactivity.",
  "version": "0.1.2",
  "license": "MIT",
  "private": false,
  "type": "module",
  "homepage": "https://data-star.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solidstarjs/solidstar.git"
  },
  "bugs": {
    "url": "https://github.com/solidstarjs/solidstar/issues"
  },
  "files": [
    "dist"
  ],
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./core": {
      "import": "./dist/core.js",
      "types": "./dist/core.d.ts"
    },
    "./aliased": {
      "import": "./dist/aliased.js",
      "types": "./dist/aliased.d.ts"
    },
    "./plugins": {
      "import": "./dist/plugins/index.js",
      "types": "./dist/plugins/index.d.ts"
    },
    "./types": {
      "import": "./dist/engine/types.js",
      "types": "./dist/engine/types.d.ts"
    }
  },
  "scripts": {
    "build": "pnpm build:main && pnpm build:core && pnpm build:aliased && tsc",
    "build:main": "esbuild src/index.ts --bundle --format=esm --minify --sourcemap --outfile=../bundles/solidstar.js",
    "build:core": "esbuild src/core.ts --bundle --format=esm --minify --sourcemap --outfile=../bundles/solidstar-core.js",
    "build:aliased": "esbuild src/aliased.ts --bundle --format=esm --minify --sourcemap --outfile=../bundles/solidstar-aliased.js",
    "dev": "vite examples",
    "bump": "changeset version && node bumpVersion.js && cp ../README.md . && pnpm build",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.6",
    "@types/node": "^24.3.0",
    "esbuild": "^0.25.9",
    "replace-in-file": "^8.3.0",
    "solid-devtools": "^0.34.3",
    "solid-element": "^1.9.1",
    "terser": "^5.43.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-solid": "^2.11.8"
  },
  "peerDependencies": {
    "solid-js": "^1.9"
  }
}