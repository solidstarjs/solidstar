{
  "name": "solidstar",
  "author": "Katja Lutz <opensource@katjalutz.ch>",
  "description": "Datastar with SolidJS reactivity.",
  "version": "0.3.0",
  "license": "MIT",
  "private": false,
  "type": "module",
  "homepage": "https://data-star.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solidstarjs/solidstar.git"
  },
  "bugs": {
    "url": "https://github.com/solidstarjs/solidstar/issues"
  },
  "files": [
    "dist"
  ],
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./core": {
      "import": "./dist/core.js",
      "types": "./dist/core.d.ts"
    },
    "./aliased": {
      "import": "./dist/aliased.js",
      "types": "./dist/aliased.d.ts"
    },
    "./plugins/": "./dist/plugins/",
    "./plugins/actions/*": {
      "import": "./dist/plugins/actions/*.js",
      "types": "./dist/plugins/actions/*.d.ts"
    },
    "./plugins/attributes/*": {
      "import": "./dist/plugins/attributes/*.js",
      "types": "./dist/plugins/attributes/*.d.ts"
    },
    "./plugins/watchers/*": {
      "import": "./dist/plugins/watchers/*.js",
      "types": "./dist/plugins/watchers/*.d.ts"
    },
    "./types": {
      "import": "./dist/engine/types.js",
      "types": "./dist/engine/types.d.ts"
    }
  },
  "scripts": {
    "build": "pnpm build:main && pnpm build:core && pnpm build:aliased && tsc && tsc-alias",
    "build:main": "esbuild src/index.ts --bundle --format=esm --minify --sourcemap --outfile=../bundles/solidstar.js --define:SOLIDSTAR_ALIAS=null",
    "build:core": "esbuild src/core.ts --bundle --format=esm --minify --sourcemap --outfile=../bundles/solidstar-core.js --define:SOLIDSTAR_ALIAS=null",
    "build:aliased": "esbuild src/aliased.ts --bundle --format=esm --minify --sourcemap --outfile=../bundles/solidstar-aliased.js --define:SOLIDSTAR_ALIAS='star'",
    "dev": "vite examples",
    "bump": "changeset version && node bumpVersion.js && cp ../README.md . && pnpm build",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@types/node": "^24.9.1",
    "esbuild": "^0.25.11",
    "replace-in-file": "^8.3.0",
    "solid-devtools": "^0.34.4",
    "solid-element": "^1.9.1",
    "terser": "^5.44.0",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vite-plugin-solid": "^2.11.10"
  },
  "peerDependencies": {
    "solid-js": "^1.9"
  }
}